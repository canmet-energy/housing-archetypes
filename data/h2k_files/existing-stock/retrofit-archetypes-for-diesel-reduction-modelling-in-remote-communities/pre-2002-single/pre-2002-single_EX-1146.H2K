  <Program class="ca.nrcan.gc.OEE.ERS.ErsProgram">
    <Labels>
      <English>EnerGuide Rating System</English>
      <French>Système de cote ÉnerGuide</French>
    </Labels>
    <Version major="15" minor="11" build="21119">
      <Labels>
        <English>v15.11b21119</English>
        <French>v15.11b21119</French>
      </Labels>
    </Version>
    <SdkVersion major="1" minor="16" build="21119">
