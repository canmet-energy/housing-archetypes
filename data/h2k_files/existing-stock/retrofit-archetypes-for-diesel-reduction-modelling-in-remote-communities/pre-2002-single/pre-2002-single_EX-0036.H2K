    <Program class="ca.nrcan.gc.OEE.ERS.ErsProgram">
        <Labels>
            <English>EnerGuide Rating System</English>
            <French>Système de cote ÉnerGuide</French>
        </Labels>
        <Version major="15" minor="6" build="18345">
