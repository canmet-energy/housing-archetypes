        <Options>
            <Main applyHouseholdOperatingConditions="false" applyReducedOperatingConditions="false" atypicalElectricalLoads="false" waterConservation="false" referenceHouse="false" greenerHomesTab="true">
                <Vermiculite code="1">
                    <English>Unknown</English>
                    <French>Inconnu</French>
                </Vermiculite>
            </Main>
            <RURComments xml:space="preserve">
                <Renewables>Through the Canada Greener Homes Grant initiative, a grant of $1,000 per KW is available for installing 

a photovoltaic solar panel. If you choose to install a photovoltaic (PV) system, it is strongly 

recommended that a full assessment by a professional solar photovoltaic installer, including the 

measuring of solar irradiance (how much sunlight falls on the roof) is undertaken to provide detailed 

information on considerations for your home and specific installation recommendations, including the 

size and related energy production of the system. The rated PV panel must have peak power capacity 7

higher than or equal to 1.0 kW. The system must be composed of photovoltaic (PV) panel and inverter 

certified to CSA Standards.</Renewables>
            </RURComments>
            <GreenerHomes basementSlabInsulated="false" moistureProofCrawlSpace="false" waterproofing="false" roofingMembrane="false" minR10ContinuousExposedFloors="false" backwaterValve="false" sumpPump="false" smartThermostats="false" remoteCommunities="true" evaluationCost="50">
                <Community>Whitehorse</Community>
            </GreenerHomes>
        </Options>
