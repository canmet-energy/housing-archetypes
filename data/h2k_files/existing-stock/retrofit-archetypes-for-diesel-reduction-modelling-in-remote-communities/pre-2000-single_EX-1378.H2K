    <Program class="ca.nrcan.gc.OEE.ERS.ErsProgram">
        <Labels>
            <English>EnerGuide Rating System</English>
            <French>SystÃ¨me de cote ÃnerGuide</French>
        </Labels>
        <Version major="15" minor="5" build="8">
            <Labels>
                <English>v15.5b8</English>
                <French>v15.5b8</French>
            </Labels>
        </Version>
        <SdkVersion major="1" minor="16">
            <Labels>
